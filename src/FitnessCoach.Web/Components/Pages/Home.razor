@page "/"

<PageTitle>Dashboard – FitnessCoach</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Welcome to FitnessCoach</MudText>
<MudText Typo="Typo.body1" Class="mb-6">
    Create your training profile, register injuries, and get a personal weekly training plan
    generated by AI — adapted to your goal, level and injuries.
</MudText>

<MudGrid>
    <MudItem xs="12" md="4">
        <MudCard Elevation="2" Class="h-100">
            <MudCardContent>
                <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Primary" Size="Size.Large"/>
                <MudText Typo="Typo.h6">Profile</MudText>
                <MudText Typo="Typo.body2">Your goal, experience level and how often you want to train.</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudCard Elevation="2" Class="h-100">
            <MudCardContent>
                <MudIcon Icon="@Icons.Material.Filled.Healing" Color="Color.Primary" Size="Size.Large"/>
                <MudText Typo="Typo.h6">Injuries</MudText>
                <MudText Typo="Typo.body2">Register injuries so your plan avoids exercises that strain them.</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudCard Elevation="2" Class="h-100">
            <MudCardContent>
                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Color="Color.Primary" Size="Size.Large"/>
                <MudText Typo="Typo.h6">Weekly plan</MudText>
                <MudText Typo="Typo.body2">Generate a personal weekly plan and browse your plan history.</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>
